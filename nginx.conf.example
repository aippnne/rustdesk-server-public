# ============================================================
# Nginx 反代配置（webclient2 / 管理后台 加载加速）—— 生产版结构
# 部署方式：
#   1) 复制本文件到服务器 /root/rustdesk/nginx.conf
#   2) docker compose -f docker-compose.example.yml up -d
# 端口说明：
#   - Nginx 监听 21114（对外）：API / 管理后台 / 网页客户端统一入口
#   - apimain 改监听内部端口 21140（通过 RUSTDESK_API_GIN_API_ADDR 指定）
# 生效方式：修改后 docker compose restart web-nginx
# 验证：
#   压缩生效：curl -sI -H 'Accept-Encoding: gzip' http://127.0.0.1:21114/webclient2/js/dist/vendor.js
#   缓存生效：curl -sI http://127.0.0.1:21114/webclient2/js/dist/vendor.js?v=test | grep Cache-Control
# ============================================================

user nginx;
worker_processes auto;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    client_max_body_size 20m;

    # ============ gzip 压缩（webclient2 提速关键）============
    gzip on;                 # 开启压缩
    gzip_min_length 1k;      # 小于1KB不压缩（小文件无收益）
    gzip_comp_level 6;       # 压缩级别 1-9，6为均衡
    gzip_vary on;            # 响应带 Vary: Accept-Encoding，利于缓存协商
    gzip_proxied any;        # 必须：允许压缩来自 apimain 的反代响应（默认不压缩）
    gzip_types *;            # 压缩所有MIME类型（apimain返回text/javascript等特殊类型）

    server {
        listen 21114;        # 对外端口（原apimain的21114让给了nginx）
        server_name _;

        # 全量反代：转发到 apimain 内部端口 21140（保留原有所有路由/API/登录）
        location / {
            proxy_pass http://127.0.0.1:21140;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 静态资源强缓存 30 天（webclient2=web2目录、管理后台=admin目录）
        # 命中后浏览器本地缓存，二次打开秒开；版本更新后?v=xx 变化自动失效重新拉取
        location ~ ^/(webclient2|web2|admin)/.*\.(js|css|wasm|png|jpg|svg|woff2|ico|json|map)(\?.*)?$ {
            proxy_pass http://127.0.0.1:21140;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            expires 30d;                                # 过期时间30天
            add_header Cache-Control "public, max-age=2592000";  # 强缓存30天
        }
    }
}
